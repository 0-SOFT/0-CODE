{
  "apps": [
    {
      "name": "claude-autonomous-__PROJECT_NAME__",
      "script": "core/supervisor.mjs",
      "cwd": ".0-code",
      "args": ["--backend", "codex"],
      "restart_delay": 5000,
      "max_restarts": 20,
      "kill_timeout": 10000,
      "stop_exit_codes": [0],
      "out_file": "./run/pm2-out.log",
      "error_file": "./run/pm2-error.log",
      "merge_logs": true,
      "env": {
        "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "100000"
      }
    }
  ]
}
