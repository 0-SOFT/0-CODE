# Copy this file to config/.env and fill in the values you need.
# config/.env is gitignored. Never commit real values here.
#
# Nothing in this file is required to run the framework itself — each variable
# enables one optional capability, and the framework says plainly when one is missing.

# --- Engines -------------------------------------------------------------------

# Required for the OpenCode backend (any OpenRouter model).
OPENROUTER_API_KEY=

# Optional: override the model routing preset without touching code.
# See core/model-routing.mjs for what each tier is used for.
OPENROUTER_MODEL_HIGH=
OPENROUTER_MODEL_MID=
OPENROUTER_MODEL_LOW=
OPENROUTER_MODEL_SMOKE=

# --- Notifications -------------------------------------------------------------

# Without both of these you will NOT be told when the loop stops — you will have
# to check docs/STATE.md yourself. Bootstrap says so at install time.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP servers ---------------------------------------------------------------

# Referenced as ${GITHUB_TOKEN} from an MCP manifest; the value never leaves this file.
GITHUB_TOKEN=
