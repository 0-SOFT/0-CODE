{
  "$schema_comment": "Generated by node tools/gen-settings.mjs from core/permissions-policy.mjs. Do not edit by hand.",
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "1000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/run-hook.cmd safety-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/run-hook.cmd save-session-log"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/run-hook.cmd ralph-loop-stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/run-hook.cmd save-session-log"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(git rev-list *)",
      "Bash(git show *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(node *)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm install -g *)",
      "Bash(pm2 *)",
      "Bash(pytest*)",
      "Bash(go test*)",
      "Bash(cargo test*)",
      "Bash(jq *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(test *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(curl https://api.telegram.org/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  }
}
