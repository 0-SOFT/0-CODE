# Generated by tools/gen-ignore.mjs from lib/ignore-policy.mjs — do not edit by hand.
# Shipped to the published tree as its .gitignore. Without it the first person to clone the
# repository, add their key to config/.env and commit would publish that key.

# Secrets — never commit these
.env
.env.local
.env.*.local
config/.env
*.secret
*.key
*.pem

# Backend artefacts regenerated by provisioning on EACH machine
# opencode.json inlines REAL secret values: tools/provision-opencode.mjs reads config/.env
# and substitutes MCP keys and session strings into it. Treat it exactly like .env.
# AGENTS.md is generated from CLAUDE.md for both OpenCode and Codex; .opencode/ is machine-local.
# Codex guard artifacts live outside the project; login uses the personal home unless managed mode is selected.
# The selected backend marker belongs to each local installation.
opencode.json
AGENTS.md
.opencode/
.claude/.framework-backend

# MCP server artefacts
# The Playwright MCP server drops page snapshots next to the project. In this repository they
# turned out to belong to an entirely unrelated project and were committed by one `git add .`.
.playwright-mcp/

# Session transcripts
# They contain everything the agent read during a session, including the contents of secret
# files — a proven leak channel, not a theoretical one. Durable records of the loop's work
# belong in the configured reports role.
docs/logs/

# Loop runtime state: it describes a process, not the project
.0-code/run/
docs/.loop.lock
docs/.loop.lock.guard*
docs/.loop.lock.tmp-*
docs/.loop-children
docs/.loop-progress
docs/STATE.md.bak.*

# Temporary files
*.tmp
*.temp
*.swp
*.bak
*.bak.*
*~
*.log

# Operating system and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Process manager and local scaffolds
# Nothing in this repository creates these; they are cheap insurance against a local run
# leaving artefacts behind. toolset/ is deliberately NOT ignored — it is part of the repository.
.pm2/
ecosystem.config.local.js
experiments/
